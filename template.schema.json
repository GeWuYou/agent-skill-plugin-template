{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "agent-skill-plugin-template",
  "version": "1.0.0",
  "description": "Schema for initializing a Bun and TypeScript Agent Skills plugin project.",
  "type": "object",
  "required": ["pluginId", "displayName", "description", "authorName", "repositoryUrl"],
  "properties": {
    "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "authorName": { "type": "string", "minLength": 1 },
    "authorEmail": { "type": "string" },
    "authorUrl": { "type": "string", "format": "uri" },
    "license": { "type": "string", "default": "MIT" },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "homepageUrl": { "type": "string", "format": "uri" },
    "packageName": { "type": "string", "minLength": 1 },
    "packageSlug": { "type": "string" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$", "default": "0.0.0" },
    "defaultSkillPrefix": { "type": "string" },
    "supportedPlatforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claude", "codex", "universal"] } },
    "shortDescription": { "type": "string", "minLength": 1 },
    "longDescription": { "type": "string", "minLength": 1 },
    "developerName": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "defaultPrompts": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "brandColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  },
  "additionalProperties": false
}
