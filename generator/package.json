{
  "name": "@agent-foundry/create-agent-plugin",
  "version": "1.0.0",
  "description": "Scaffold and validate portable Agent Skills plugin projects.",
  "type": "module",
  "bin": { "create-agent-plugin": "dist/index.js" },
  "scripts": {
